@model TaskItem
@{
    ViewData["Title"] = "Add Task";
}
<h1>Add a task</h1>
<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label asp-for="Title"></label>
    <input asp-for="Title" placeholder="e.g. Learn dependency injection" />
    <span asp-validation-for="Title" class="validation"></span>

    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="4" placeholder="Add a short description (optional)"></textarea>
    <span asp-validation-for="Description" class="validation"></span>

    <label class="check-label"><input asp-for="IsCompleted" /> Mark as completed</label>
    <div class="actions">
        <button class="button" type="submit">Save task</button>
        <a class="button button-light" asp-action="Index">Cancel</a>
    </div>
</form>
